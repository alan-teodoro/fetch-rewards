subscription_name = "customer-dev-ai"
# Optional when resolving database_name by subscription ID instead of name.
# subscription_id = 123456
database_name     = "agent-memory-db"
agent_memory_name = "shopping-agent-memory"

short_term_ttl_seconds     = 86400
long_term_ttl_seconds      = 31536000
extraction_cadence_seconds = 300

# Optional customer-managed model configuration. The API requires llm and
# embedding to be configured together when the store is created.
# llm = {
#   provider = "openai"
#   model    = "gpt-4o-mini"
#   credentials = {
#     type            = "apiKey"
#     api_key_version = 1 # Increase when rotating the API key.
#   }
# }
# llm_api_key = "set-with-sensitive-tfvars-or-TF_VAR_llm_api_key"
#
# embedding = {
#   provider = "openai"
#   model    = "text-embedding-3-small"
#   credentials = {
#     type            = "apiKey"
#     api_key_version = 1 # Increase when rotating the API key.
#   }
# }
# embedding_api_key = "set-with-sensitive-tfvars-or-TF_VAR_embedding_api_key"

summarization = {
  enabled          = true
  trigger_strategy = "event_count"
  event_count = {
    threshold    = 20
    retain_count = 10
  }
}

api_keys = {
  runtime = {
    name = "runtime"
  }
}

# Direct-stack example: uncomment this complete object to redact email matches
# during long-term extraction. It does not filter session events or direct writes.
# For the JSON workflow, use the equivalent property inside the store config.
# null omits the policy block; enabled = false explicitly requests policy off.
# See docs/configuration-reference.md for semantic and custom regex families.
# long_term_memory_exclusions = {
#   enabled = true
#   built_in_detectors = {
#     enabled = true
#     detectors = [
#       {
#         id      = "email"
#         enabled = true
#         action  = "redact"
#       }
#     ]
#   }
# }
